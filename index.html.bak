  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the price of luxury tempo traveller in Bangalore?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard 12 seater starts at ₹18/km, luxury 9 seater with Maharaja seats at ₹32/km, Force Urbania at ₹38-60/km, and mini bus 20+ seater at ₹28-35/km. All prices include AC, professional driver, fuel, and 24/7 support. No hidden charges."
        }
      },
      {
        "@type": "Question",
        "name": "Do you have Maharaja seats tempo traveller?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our 9 seater, 12 seater, and 14 seater luxury tempo travellers come with Maharaja pushback seats in 1x1 configuration. Features include individual AC vents, USB charging ports, 21-inch LED TV, premium leather upholstery, and roof-top luggage carrier."
        }
      },
      {
        "@type": "Question",
        "name": "How do I book a tempo traveller in Bangalore?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Booking takes 2 minutes. Click any WhatsApp button or call +91 99013 33113. Tell us your vehicle preference, destination, dates and group size. Get a customized quote within 5 minutes. Pay a small advance to confirm; balance on pickup."
        }
      },
      {
        "@type": "Question",
        "name": "What destinations do you cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We cover all major South Indian destinations from Bangalore including Tirupati (3 hrs), Mysore (2.5 hrs), Coorg (5 hrs), Ooty (6 hrs), Chennai (6 hrs), Pondicherry (5 hrs), Hyderabad (8 hrs), Goa (10 hrs), and Shirdi (12 hrs). One-way, round trips, and multi-city itineraries available."
        }
      },
      {
        "@type": "Question",
        "name": "Is your fleet 100% owned?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Unlike aggregators who outsource, we own every vehicle from 7 seater sedans to 50 seater buses. No third-party vehicles, no last-minute substitutions. All vehicles are sanitized, GPS-tracked, and maintained in-house."
        }
      },
      {
        "@type": "Question",
        "name": "Do you offer airport transfers and city sightseeing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Airport transfers with flight tracking included, and half-day/full-day city sightseeing packages covering Bangalore Palace, Lalbagh, Cubbon Park, ISKCON, and Nandi Hills. Customizable itineraries available."
        }
      }
    ]
  }
  </script>
