  <!-- ===== SCRIPTS ===== -->
  <script>
    // Header scroll effect
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 80);
    });

    // Pill nav sliding backdrop
    const navPill = document.getElementById('navPill');
    const backdrop = document.getElementById('pillBackdrop');
    if (navPill) {
      const active = navPill.querySelector('.active');
      if (active) {
        const updateBackdrop = (el) => {
          const r = el.getBoundingClientRect();
          const pr = navPill.getBoundingClientRect();
          backdrop.style.left = (r.left - pr.left) + 'px';
          backdrop.style.width = r.width + 'px';
          backdrop.style.opacity = '1';
        };
        updateBackdrop(active);
        navPill.querySelectorAll('a').forEach(a => {
          a.addEventListener('mouseenter', () => updateBackdrop(a));
          a.addEventListener('mouseleave', () => updateBackdrop(active));
        });
      }
    }

    // Mobile overlay
    const menuToggle = document.getElementById('menuToggle');
    const mobileOverlay = document.getElementById('mobileOverlay');
    if (menuToggle) {
      menuToggle.addEventListener('click', () => {
        mobileOverlay.classList.toggle('open');
        menuToggle.classList.toggle('active');
      });
      mobileOverlay.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          mobileOverlay.classList.remove('open');
          menuToggle.classList.remove('active');
        });
      });
    }


  </script>

</body>

</html>