  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      color: #1f2937;
      -webkit-font-smoothing: antialiased;
    }

    .container-custom {
      max-width: 1280px;
      margin: 0 auto;
      padding-left: clamp(1rem, 0.5rem + 2vw, 2rem);
      padding-right: clamp(1rem, 0.5rem + 2vw, 2rem);
    }

    .gradient-amber {
      background: linear-gradient(135deg, #f59e0b, #f97316);
    }

    .gradient-navy {
      background: linear-gradient(135deg, #1a365d, #2b6cb0);
    }

    .shadow-card {
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    }

    .shadow-card:hover {
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1);
    }

    .btn-primary {
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(245, 158, 11, 0.35);
    }

    .btn-outline {
      transition: all 0.3s ease;
    }

    .btn-outline:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(26, 54, 93, 0.12);
    }

    .whatsapp-float {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 50;
      transition: all 0.3s ease;
      width: 56px;
      height: 56px;
    }

    .whatsapp-float:hover {
      transform: scale(1.1);
    }

    .fleet-card {
      transition: all 0.3s ease;
    }

    .fleet-card:hover {
      transform: translateY(-4px);
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary {
      list-style: none;
      cursor: pointer;
    }

    .faq-item[open] summary .faq-icon {
      transform: rotate(45deg);
    }

    .faq-icon {
      transition: transform 0.3s ease;
    }

    .animate-on-scroll {
      opacity: 0;
      transform: translateY(24px);
      transition: all 0.6s ease-out;
    }

    .animate-on-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .section-py {
      padding-top: clamp(2.5rem, 1.5rem + 3vw, 6rem);
      padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 6rem);
    }

    .text-balance {
      text-wrap: balance;
    }

    /* Accessibility - Visible Keyboard Focus */
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    summary:focus-visible {
      outline: 2px solid #f59e0b;
      outline-offset: 3px;
    }

    /* Accessibility - Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* === HEADER (avtonova-style) === */
    .site-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding-top: 24px;
      transition: all 0.4s ease;
    }

    .site-header.scrolled {
      position: fixed;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .site-header.scrolled .nav-pill a {
      color: #111;
      font-weight: 700;
    }

    .site-header.scrolled .menu-toggle {
      color: #111;
      background: rgba(0, 0, 0, 0.05);
    }

    .site-header.scrolled .soc-icon {
      color: #111;
      background: rgba(0, 0, 0, 0.05);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Pill nav */
    .nav-pill {
      display: flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 9999px;
      padding: 3px;
      position: relative;
    }

    .nav-pill .pill-backdrop {
      position: absolute;
      top: 3px;
      bottom: 3px;
      border-radius: 9999px;
      background: #f59e0b;
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 0;
      opacity: 0;
    }

    .nav-pill a {
      position: relative;
      z-index: 1;
      padding: 10px 20px;
      font-size: 0.8125rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.25s ease;
      border-radius: 9999px;
    }

    .nav-pill a:hover {
      color: #fff;
    }

    .nav-pill a.active {
      color: #1a365d;
    }

    /* Header actions */
    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .soc-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      transition: all 0.25s ease;
      color: #fff;
    }

    .soc-icon:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: scale(1.05);
    }

    .phone-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: #fff;
      border-radius: 9999px;
      color: #1a365d;
      font-weight: 600;
      font-size: 0.8125rem;
      text-decoration: none;
      transition: all 0.25s ease;
      white-space: nowrap;
    }

    .phone-btn:hover {
      transform: scale(1.03);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    /* Mobile */
    .menu-toggle {
      display: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #fff;
    }

    .menu-toggle .close-icon {
      display: none;
    }

    .menu-toggle.active .ham-icon {
      display: none;
    }

    .menu-toggle.active .close-icon {
      display: block;
      color: #1a365d;
    }

    .mobile-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #fff;
      z-index: 99;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.35s ease;
    }

    .mobile-overlay.open {
      opacity: 1;
      visibility: visible;
    }

    .mobile-overlay nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    .mobile-overlay a {
      font-size: 1.25rem;
      font-weight: 600;
      color: #1a365d;
      text-decoration: none;
    }

    .mobile-overlay .mobile-socs {
      display: flex;
      gap: 12px;
      margin-top: 48px;
    }

    .mobile-overlay .mobile-socs .soc-icon {
      background: #1a365d;
      color: #fff;
    }

    @media (max-width: 1024px) {
      .nav-pill {
        display: none;
      }

      .menu-toggle {
        display: flex;
      }

      .site-header {
        padding-top: 16px;
      }
    }
  </style>
